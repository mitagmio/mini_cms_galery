LISTEN_ADDR=:8080
DATA_DIR=/data
UPLOAD_DIR=/data/uploads
PREVIEW_DIR=/data/preview
FRONT_DIR=/front
# Theme kit + publish tree (compose mounts ./front → /front)
FRONT_THEME_SRC=/front
# Import static front HTML into CMS blocks on boot (1/0; unset = auto when front has pages)
# IMPORT_FRONT=1
CANONICAL_BASE=https://sheyanova.art
CORS_ORIGINS=https://sheyanova.art,https://www.sheyanova.art,https://api.sheyanova.art,http://localhost:5173,http://localhost:3000
PUBLIC_API_URL=https://api.sheyanova.art
ADMIN_TOKEN=change-me-to-a-long-random-secret
MAX_UPLOAD_MB=25

# Contact form mail (POST /api/contact). Required to deliver messages.
# Gmail: SMTP_PASS must be a 16-character App Password (not the account password).
# SMTP_FROM should equal SMTP_USER unless the alias is verified as Gmail "Send mail as".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional Cloudflare Turnstile (invisible). Leave empty for honeypot + timing only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GitHub Pages publish (fill GH_TOKEN before enabling publish from admin)
GITHUB_REPO=mitagmio/site_sheyanova
GITHUB_BRANCH=main
# Prefer one auth method (API accepts GH_TOKEN or GITHUB_TOKEN):
GH_TOKEN=
# GITHUB_TOKEN=
# GHP_SSH_KEY_PATH=/data/ghp-ssh/id_ed25519
