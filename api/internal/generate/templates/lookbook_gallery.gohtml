{{define "lookbook_gallery"}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<title>{{.HTMLTitle}} - {{.Settings.SiteName}}</title>
<meta name="description" content="{{.MetaDescription}}"/>
<meta content="noai, noimageai" name="robots"/>
<link rel="canonical" href="{{.CanonicalURL}}"/>
<link href="/assets/theme/panorama/stylesheets/jquery.scrollpane.css" media="screen" rel="stylesheet"/>
<link href="/static/theme_api/v1/hosted_fonts-58e499298cb6db37c90c2bd6bd2ad287c8423ad12d9c2cc346a2af9afc8b7fd4.css" media="screen" rel="stylesheet"/>
<link href="/static/theme_api/vendor/webtype_fonts.min-a27384810945198dd373502796bfbada62cc8409c49831a8778ac894e78f7749.css" media="screen" rel="stylesheet"/>
<link href="/static/theme_api/v1/protected_images-6cc002aad772e14af53bbbb966d0611491b39e25fc8fba42e94598f98d535828.css" media="screen" rel="stylesheet"/>
<link href="/assets/theme/stylesheet.css?v=7" media="screen" rel="stylesheet"/>
<link href="/assets/theme/lookbook-harden.css?v=7" media="screen" rel="stylesheet"/>
<link href="/assets/theme/lookbook.css?v=4" media="screen" rel="stylesheet"/>
<link href="/assets/theme/gallery-load.css?v=2" media="screen" rel="stylesheet"/>
<noscript><style>.lookbook-tile img,.gallery_content .asset img{opacity:1!important}.gallery-load-mark{display:none!important}</style></noscript>
</head>
<body class="lookbook simple simple_page" data-shuffle-seed="{{.ShuffleSeed}}">
<div class="page clearfix">
<div class="theme_header static clearfix" id="themeHeader">
<div class="padding-div">
<div class="theme_logo">
<h1 class="logo theme_logo"><a href="{{.HomeURL}}">{{.Settings.LogoHTML}}</a></h1>
</div>
{{template "nav" .}}
</div>
</div>
<main class="lookbook-main">
<div class="lookbook-grid" id="lookbook-grid">
{{- range $i, $b := .RenderedBlocks }}
<button type="button" class="lookbook-tile" data-index="{{$i}}" aria-label="Open photo {{$i}}">
<span class="gallery-load-mark" aria-hidden="true"><span class="gallery-load-line"></span></span>
<img src="{{$b.ImageSrc}}" alt="{{$b.Alt}}" loading="lazy" decoding="async"{{if and $b.Width $b.Height}} width="{{$b.Width}}" height="{{$b.Height}}"{{end}}/>
</button>
{{- end }}
</div>
</main>
</div>
<div class="gallery" id="lookbook-overlay" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Gallery">
<button type="button" class="lookbook-close" aria-label="Close gallery">
<span aria-hidden="true">&times;</span>
</button>
<button type="button" class="lookbook-nav lookbook-nav-prev" aria-label="Previous photo">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15.5 4.5L8 12l7.5 7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>
<button type="button" class="lookbook-nav lookbook-nav-next" aria-label="Next photo">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8.5 4.5L16 12l-7.5 7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>
<div id="content">
<div class="gallery_content">
{{template "gallery_strip" .}}
</div>
</div>
</div>
<script>
window._4ORMAT_DATA = {{.FormatData}};
</script>
<script src="/assets/theme/gallery-load.js?v=2"></script>
<script src="/assets/theme/panorama/javascripts/jquery.js"></script>
<script src="/assets/theme/panorama/javascripts/jquery.mousewheel.js?v=passive1"></script>
<script src="/assets/theme/panorama/javascripts/jquery.jscrollpane.js"></script>
<script src="/assets/theme/panorama/javascripts/theme.js"></script>
<script src="/assets/theme/panorama/javascripts/gallery-wheel.js?v=5"></script>
<script src="/assets/theme/lookbook.js?v=6"></script>
</body>
</html>
{{end}}
