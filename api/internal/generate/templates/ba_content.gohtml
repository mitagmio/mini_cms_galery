{{define "ba_content"}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<title>{{.HTMLTitle}} - {{.Settings.SiteName}}</title>
<meta name="description" content="{{.MetaDescription}}"/>
<meta content="noai, noimageai" name="robots"/>
<link rel="canonical" href="{{.CanonicalURL}}"/>
<link href="/static/theme_api/v1/hosted_fonts-58e499298cb6db37c90c2bd6bd2ad287c8423ad12d9c2cc346a2af9afc8b7fd4.css" media="screen" rel="stylesheet"/>
<link href="/static/theme_api/vendor/webtype_fonts.min-a27384810945198dd373502796bfbada62cc8409c49831a8778ac894e78f7749.css" media="screen" rel="stylesheet"/>
<link href="/static/theme_api/v1/protected_images-6cc002aad772e14af53bbbb966d0611491b39e25fc8fba42e94598f98d535828.css" media="screen" rel="stylesheet"/>
<link href="/fonts/ss-standard-v2/ss-standard.css" media="screen" rel="stylesheet"/>
<link href="/assets/theme/stylesheet.css?v=16" media="screen" rel="stylesheet"/>
<link href="/assets/theme/ba-harden.css?v=11" media="screen" rel="stylesheet"/>
<link href="/assets/theme/gallery-load.css?v=2" media="screen" rel="stylesheet"/>
<noscript><style>.ba-await .comparison_slider__slider_image{opacity:1!important}.gallery-load-mark{display:none!important}</style></noscript>
<link href="/static/theme_api/vendor/960_simple-1-80ab8eb2695abe415bd536608db207267db1a467f2841da1c01b06c3559dd9c6.css" media="screen" rel="stylesheet"/>
<link href="/static/_common/animation-7fc12d665fca943072e7f3c6c84d756b935958c9d92f8a940de7dcfd69c2b253.css" media="screen" rel="stylesheet"/>
<link href="/static/_common/module_base-52f9ad05f403265ad4033430f00ab7b3dca79686e1b73cf6456eb55acf10a750.css" media="screen" rel="stylesheet"/>
<link href="/static/_common/comparison_slider/comparison_slider-5853845bcb76137b17c4fadcbf930290ba737ef66b8c0ce4f438f3f515f5891e.css" media="screen" rel="stylesheet"/>
</head>
<body class="content content_type content_page simple simple_page">
<div class="page">
<div class="theme_header static clearfix" id="themeHeader">
<div class="padding-div">
<div class="theme_logo">
<h1 class="logo theme_logo"><a href="{{.HomeURL}}">{{.Settings.LogoHTML}}</a></h1>
</div>
{{template "nav" .}}
</div>
</div>
<main class="container">
<div class="_4ORMAT_content_wrapper" id="content_page_wrapper">
<div class="_4ORMAT_content_page_container _4ormat_sort">
{{template "blocks" .}}
</div>
</div>
</main>
</div>
<script src="/static/theme_api/vendor/jquery-1.11.2.min-cc83565074b3fa7f2283f7f4d56b90ad171ede87008448ed5d2e91c50575bed1.js"></script>
<script>
window._4ORMAT = window._4ORMAT || {};
window._4ORMAT.jQuery = window.jQuery;
window._4ORMAT.$ = window.jQuery;
</script>
<script src="/static/_common/bundles/comparison-slider.bundle-a74f8f79e51721e3eb22256cd3a86c79bd2e1344335a77a5c46852510b5743fe.js"></script>
<script>window._4ORMAT_DATA=window._4ORMAT_DATA||{page:{type:"content"},theme:{}};</script>
<script src="/assets/theme/mobile-nav.js?v=1"></script>
<script src="/assets/theme/theme.js?v=2"></script>
<script src="/assets/theme/ba-back-top.js?v=1"></script>
<script src="/assets/theme/gallery-load.js?v=2"></script>
<script>
(function(){function reveal(){document.querySelectorAll('._4ORMAT_content_page_row').forEach(function(el){el.classList.add('in-viewport');el.style.opacity='1';el.style.transform='none';});}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',reveal);else reveal();window.addEventListener('load',reveal);})();
</script>
{{template "yandex_metrika" .}}
</body>
</html>
{{end}}
