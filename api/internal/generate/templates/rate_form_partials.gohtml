<label class="rate-check"><input type="checkbox" name="colorwork" value="Basic RAW Development"/> Basic RAW Development</label>
<label class="rate-check"><input type="checkbox" name="colorwork" value="Color Correction by Reference"/> Color Correction by Reference</label>
<label class="rate-check"><input type="checkbox" name="colorwork" value="No-Reference Color Image Grading (options to our taste)"/> No-Reference Color Image Grading (options to our taste)</label>
<label class="rate-check"><input type="checkbox" name="colorwork" value="Change the Color of Individual Elements"/> Change the Color of Individual Elements</label>
<label class="rate-check"><input type="checkbox" name="colorwork" value="Contrast Enhancement"/> Contrast Enhancement</label>
<label class="rate-check"><input type="checkbox" name="colorwork" value="Working with Light Accents: Highlighting the Main Object by Brightness Adjusting"/> Working with Light Accents: Highlighting the Main Object by Brightness Adjusting</label>
</fieldset>
{{end}}

{{define "rate_background_fashion"}}
<fieldset class="rate-fieldset">
<legend>Background Editing</legend>
<label class="rate-check"><input type="checkbox" name="background" value="Dust, Stain, and Scratch Removal"/> Dust, Stain, and Scratch Removal</label>
<label class="rate-check"><input type="checkbox" name="background" value="Clipping mask"/> Clipping mask</label>
<label class="rate-check"><input type="checkbox" name="background" value="Background Replacement"/> Background Replacement</label>
</fieldset>
{{end}}

{{define "rate_background_product"}}
<fieldset class="rate-fieldset">
<legend>Background Editing</legend>
<label class="rate-check"><input type="checkbox" name="background" value="Dust, Spot, and Scratch Removal"/> Dust, Spot, and Scratch Removal</label>
<label class="rate-check"><input type="checkbox" name="background" value="Clipping mask"/> Clipping mask</label>
<label class="rate-check"><input type="checkbox" name="background" value="Background Replacement"/> Background Replacement</label>
<label class="rate-check"><input type="checkbox" name="background" value="Create a mirror image effect"/> Create a mirror image effect</label>
<label class="rate-check"><input type="checkbox" name="background" value="Subject Shadow Addition"/> Subject Shadow Addition</label>
</fieldset>
{{end}}

{{define "rate_model_fashion"}}
<fieldset class="rate-fieldset">
<legend>Model Editing</legend>
<label class="rate-check"><input type="checkbox" name="model" value="Adjust and Change Facial Features (Eyes, Brows, Nose, Lips, Teeth Shape Correction)"/> Adjust and Change Facial Features (Eyes, Brows, Nose, Lips, Teeth Shape Correction)</label>
<label class="rate-check"><input type="checkbox" name="model" value="Makeup Correction"/> Makeup Correction</label>
<label class="rate-check"><input type="checkbox" name="model" value="Manicure Adjustment"/> Manicure Adjustment</label>
<label class="rate-check"><input type="checkbox" name="model" value="Hair Retouching: (Stray Hair Cleanup, Fill Hair Gaps)"/> Hair Retouching: (Stray Hair Cleanup, Fill Hair Gaps)</label>
</fieldset>
{{end}}

{{define "rate_model_beauty"}}
<fieldset class="rate-fieldset">
<legend>Model Editing</legend>
<label class="rate-check"><input type="checkbox" name="model" value="Adjust and Change Facial Features (Eyes, Brows, Nose, Lips, Teeth Shape Correction)"/> Adjust and Change Facial Features (Eyes, Brows, Nose, Lips, Teeth Shape Correction)</label>
<label class="rate-check"><input type="checkbox" name="model" value="Makeup Correction"/> Makeup Correction</label>
<label class="rate-check"><input type="checkbox" name="model" value="Manicure Adjustment"/> Manicure Adjustment</label>
<label class="rate-check"><input type="checkbox" name="model" value="Hair Retouching: (Stray Hair Cleanup, Fill Hair Gaps)"/> Hair Retouching: (Stray Hair Cleanup, Fill Hair Gaps)</label>
<label class="rate-check"><input type="checkbox" name="model" value="Detailed Lip Retouching"/> Detailed Lip Retouching</label>
<label class="rate-check"><input type="checkbox" name="model" value="Cosmetic Product Retouching in Frame (Lipstick, Powder, Perfume, etc.)"/> Cosmetic Product Retouching in Frame (Lipstick, Powder, Perfume, etc.)</label>
<label class="rate-check"><input type="checkbox" name="model" value="Clothing Retouching (Wrinkle Softening, Shape Correction)"/> Clothing Retouching (Wrinkle Softening, Shape Correction)</label>
</fieldset>
{{end}}

{{define "rate_clothing"}}
<fieldset class="rate-fieldset">
<legend>Clothing Editing</legend>
<label class="rate-check"><input type="checkbox" name="clothing" value="General Cleaning (Pilling, Dust, Threads)"/> General Cleaning (Pilling, Dust, Threads)</label>
<label class="rate-check"><input type="checkbox" name="clothing" value="Wrinkle/Crease Smoothing"/> Wrinkle/Crease Smoothing</label>
<label class="rate-check"><input type="checkbox" name="clothing" value="Shape Correction"/> Shape Correction</label>
<label class="rate-check"><input type="checkbox" name="clothing" value="Fix Clothing, Move Clothing (closer to the body)"/> Fix Clothing, Move Clothing (closer to the body)</label>
<label class="rate-check"><input type="checkbox" name="clothing" value="Clothing Part Replacement from Additional Shots/Plates"/> Clothing Part Replacement from Additional Shots/Plates</label>
</fieldset>
{{end}}

{{define "rate_footwear"}}
<fieldset class="rate-fieldset">
<legend>Footwear Editing</legend>
<label class="rate-check"><input type="checkbox" name="footwear" value="General Cleaning (Dust, Scratches)"/> General Cleaning (Dust, Scratches)</label>
<label class="rate-check"><input type="checkbox" name="footwear" value="Tape Removal from Shoe Sole"/> Tape Removal from Shoe Sole</label>
<label class="rate-check"><input type="checkbox" name="footwear" value="Shoe Resizing to Models Foot Size"/> Shoe Resizing to Models Foot Size</label>
</fieldset>
{{end}}

{{define "rate_objectwork"}}
<fieldset class="rate-fieldset">
<legend>Object Editing</legend>
<label class="rate-check"><input type="checkbox" name="objectwork" value="Dust, Spot, Scratch, Chip, and Minor Flaw Removal"/> Dust, Spot, Scratch, Chip, and Minor Flaw Removal</label>
<label class="rate-check"><input type="checkbox" name="objectwork" value="Object Alignment, Perspective Correction"/> Object Alignment, Perspective Correction</label>
<label class="rate-check"><input type="checkbox" name="objectwork" value="Highlights Correction, Shape Enhancement, Transition Smoothing"/> Highlights Correction, Shape Enhancement, Transition Smoothing</label>
<label class="rate-check"><input type="checkbox" name="objectwork" value="Highlight Addition"/> Highlight Addition</label>
<label class="rate-check"><input type="checkbox" name="objectwork" value="Glare Reflection Removal"/> Glare Reflection Removal</label>
<label class="rate-check"><input type="checkbox" name="objectwork" value="Refining Facets of Diamonds"/> Refining Facets of Diamonds</label>
<label class="rate-check"><input type="checkbox" name="objectwork" value="Sharpening"/> Sharpening</label>
<label class="rate-check"><input type="checkbox" name="objectwork" value="Brightness&amp;Contrast Enhancement"/> Brightness&amp;Contrast Enhancement</label>
<label class="rate-check"><input type="checkbox" name="objectwork" value="Improving lights and Shadows"/> Improving lights and Shadows</label>
<label class="rate-check"><input type="checkbox" name="objectwork" value="Metal Polishing"/> Metal Polishing</label>
<label class="rate-check"><input type="checkbox" name="objectwork" value="Text and Logo Editing (add highlight/replacement from additional files or delete unnecessary text)"/> Text and Logo Editing (add highlight/replacement from additional files or delete unnecessary text)</label>
<label class="rate-check"><input type="checkbox" name="objectwork" value="Image Compositing, Object Addition and Replacement"/> Image Compositing, Object Addition and Replacement</label>
</fieldset>
{{end}}

{{define "rate_hairretouch"}}
<fieldset class="rate-fieldset">
<legend>Hair retouching</legend>
<label class="rate-check"><input type="checkbox" name="hairretouch" value="Remove Flyaway Hair"/> Remove Flyaway Hair</label>
<label class="rate-check"><input type="checkbox" name="hairretouch" value="Hair Drawing"/> Hair Drawing</label>
<label class="rate-check"><input type="checkbox" name="hairretouch" value="Fill Hair Gaps"/> Fill Hair Gaps</label>
<label class="rate-check"><input type="checkbox" name="hairretouch" value="Change Hair Color"/> Change Hair Color</label>
<label class="rate-check"><input type="checkbox" name="hairretouch" value="Hair Color Enhancement/Saturation Addition"/> Hair Color Enhancement/Saturation Addition</label>
<label class="rate-check"><input type="checkbox" name="hairretouch" value="Highlights and Depth Intensification"/> Highlights and Depth Intensification</label>
<label class="rate-check"><input type="checkbox" name="hairretouch" value="Hair Smoothing/Length Softening"/> Hair Smoothing/Length Softening</label>
</fieldset>
{{end}}

{{define "rate_clipping_model"}}
<fieldset class="rate-fieldset">
<legend>Model Clipping:</legend>
<label class="rate-check"><input type="checkbox" name="clipping" value="Clipping mask"/> Clipping mask</label>
<label class="rate-check"><input type="checkbox" name="clipping" value="Background Replacement"/> Background Replacement</label>
</fieldset>
{{end}}

{{define "rate_clipping_object"}}
<fieldset class="rate-fieldset">
<legend>Item clipping:</legend>
<label class="rate-check"><input type="checkbox" name="clipping" value="Clipping mask"/> Clipping mask</label>
<label class="rate-check"><input type="checkbox" name="clipping" value="Background Replacement"/> Background Replacement</label>
</fieldset>
{{end}}

{{define "rate_steps_fashion"}}
<h3 class="rate-step">STEP 1</h3>
{{template "rate_imagelink" .}}
{{template "rate_total" .}}
{{template "rate_delivery" .}}
{{template "rate_retouch" .}}
<h3 class="rate-step">STEP 2</h3>
{{template "rate_color_ref" .}}
{{template "rate_format_std" .}}
{{template "rate_profile" .}}
<h3 class="rate-step">STEP 3</h3>
{{template "rate_colorwork_fashion" .}}
{{template "rate_background_fashion" .}}
{{template "rate_model_fashion" .}}
{{template "rate_clothing" .}}
{{template "rate_footwear" .}}
<h3 class="rate-step">STEP 4</h3>
{{template "rate_brief" .}}
{{end}}
