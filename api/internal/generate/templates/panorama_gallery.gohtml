{{define "panorama_gallery"}}
<!DOCTYPE html>
<html lang="en" class="gallery win">
<head>
<meta charset="utf-8"/>
<meta content="initial-scale=1,user-scalable=no,maximum-scale=1,width=device-width" name="viewport"/>
<title>{{.HTMLTitle}} - {{.Settings.SiteName}}</title>
<meta name="description" content="{{.MetaDescription}}"/>
<meta content="noai, noimageai" name="robots"/>
<link rel="canonical" href="{{.CanonicalURL}}"/>
<link href="/assets/theme/panorama/stylesheets/jquery.scrollpane.css" media="screen" rel="stylesheet"/>
<link href="/static/theme_api/v1/hosted_fonts-58e499298cb6db37c90c2bd6bd2ad287c8423ad12d9c2cc346a2af9afc8b7fd4.css" media="screen" rel="stylesheet"/>
<link href="/static/theme_api/vendor/webtype_fonts.min-a27384810945198dd373502796bfbada62cc8409c49831a8778ac894e78f7749.css" media="screen" rel="stylesheet"/>
<link href="/static/theme_api/v1/protected_images-6cc002aad772e14af53bbbb966d0611491b39e25fc8fba42e94598f98d535828.css" media="screen" rel="stylesheet"/>
<link href="/assets/theme/stylesheet.css?v=7" media="screen" rel="stylesheet"/>
<link href="/assets/theme/gallery-harden.css?v=8" media="screen" rel="stylesheet"/>
<style>#content{opacity:1;}</style>
</head>
<body class="gallery gallery_page">
<div class="page clearfix">
<div class="theme_header static clearfix" id="themeHeader">
<div class="padding-div">
<div class="theme_logo">
<h1 class="logo theme_logo"><a href="{{.HomeURL}}">{{.Settings.LogoHTML}}</a></h1>
</div>
{{template "nav" .}}
</div>
</div>
<div id="content">
<div class="gallery_content">
{{template "gallery_strip" .}}
</div>
</div>
</div>
<script>
window._4ORMAT_DATA = {{.FormatData}};
</script>
<script src="/assets/theme/panorama/javascripts/jquery.js"></script>
<script src="/assets/theme/panorama/javascripts/jquery.mousewheel.js?v=passive1"></script>
<script src="/assets/theme/panorama/javascripts/jquery.jscrollpane.js"></script>
<script src="/assets/theme/panorama/javascripts/theme.js"></script>
<script src="/assets/theme/panorama/javascripts/gallery-wheel.js?v=3"></script>
<script>
(function(){
  /* Format only enables wheel→horizontal when html has class "win". Force it. */
  document.documentElement.classList.add('win');
  function reveal(){
    var c=document.getElementById('content');
    if(c){c.style.opacity='1';c.style.visibility='visible';}
    document.querySelectorAll('.asset.image').forEach(function(el){el.classList.remove('loading');el.style.opacity='1';});
    document.querySelectorAll('.asset img').forEach(function(img){img.style.opacity='1';});
    if(window.jQuery){
      try{window.jQuery(window).trigger('resize');}catch(e){}
    }
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',reveal);
  else reveal();
  window.addEventListener('load',reveal);
})();
</script>
</body>
</html>
{{end}}
